{% set logging_processes = [] %}
{% for item in monitor_vm_infra_metrics | default([]) %}
  {% if item is mapping and 'process' in item %}
    {% for proc_item in item.process %}
      {% if proc_item is mapping and 'name' in proc_item %}
        {% for proc in proc_item.name %}
          {% if proc is mapping %}
            {% for proc_name, proc_config in proc.items() %}
              {% for config in proc_config %}
                {% if config is mapping and 'enable_logging' in config and config.enable_logging %}
                  {% set logging_processes = logging_processes + [proc_name] %}
                {% endif %}
              {% endfor %}
            {% endfor %}
          {% endif %}
        {% endfor %}
      {% endif %}
    {% endfor %}
  {% endif %}
{% endfor %}

{% if debug | default(false) or logging_processes | length > 0 %}
{% if ansible_os_family == "Windows" %}
windowseventlog:
  channel: Application
{% else %}
filelog:
  include:
    - /var/log/*.log
    {% for process in logging_processes %}
    - /var/log/{{ process }}/*.log
    {% endfor %}
  start_at: beginning
{% endif %}
{% endif %}