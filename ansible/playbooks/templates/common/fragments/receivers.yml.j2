{# Multi-line with proper indentation #}
receivers:
  otlp:
    protocols:
      grpc:
        endpoint: {{ otel_receiver_otlp_grpc_endpoint | default('0.0.0.0:4317') }}
      http:
        endpoint: {{ otel_receiver_otlp_http_endpoint | default('0.0.0.0:4318') }}
        
{% for item in monitor_vm_infra_metrics | default([]) %}
  hostmetrics:
  {% if item is mapping and 'process' in item %}
    {# ... iterate through process configs #}
    {% if config is mapping and 'enable_logging' in config and config.enable_logging %}
      {% set logging_processes = logging_processes + [proc_name] %}
    {% endif %}
  {% endif %}
{% endfor %}
