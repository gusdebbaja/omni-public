# OpenTelemetry Collector Configuration
# Generated by Ansible on {{ ansible_date_time.date }}

{% set enabled_receivers = [] %}
{% set enabled_processors = [] %}
{% set enabled_exporters = [] %}

# RECEIVERS
receivers:
{% if effective_otelcol_config.receivers is defined %}
{% for receiver_name, receiver_config in effective_otelcol_config.receivers.items() %}
{% if receiver_config.enabled | default(false) %}
{% set _ = enabled_receivers.append(receiver_name) %}
  {{ receiver_name }}:
{% if receiver_name == 'hostmetrics' %}
    collection_interval: {{ receiver_config.collection_interval | default('60s') }}
    scrapers:
{% for scraper in receiver_config.scrapers | default([]) %}
      {{ scraper }}:
{% endfor %}
{% elif receiver_name == 'otlp' %}
    protocols:
{% for protocol, protocol_config in receiver_config.protocols.items() %}
      {{ protocol }}:
{% for key, value in protocol_config.items() %}
        {{ key }}: {{ value }}
{% endfor %}
{% endfor %}
{% endif %}
{% endif %}
{% endfor %}
{% endif %}

{% if effective_otelcol_config.collect is defined %}
{% for receiver_name, receiver_config in effective_otelcol_config.collect.items() %}
{% if receiver_config.enabled | default(false) %}
{% set _ = enabled_receivers.append(receiver_name) %}
  {{ receiver_name }}:
{% if receiver_name == 'journald' %}
    units: {{ receiver_config.units | to_json }}
    priority: {{ receiver_config.priority | default('info') }}
{% elif receiver_name == 'windowseventlog' %}
    channel: {{ receiver_config.channel | to_json }}
{% endif %}
{% endif %}
{% endfor %}
{% endif %}

# PROCESSORS
processors:
{% for processor_name, processor_config in effective_otelcol_config.processors.items() %}
{% if processor_config.enabled | default(false) %}
{% set _ = enabled_processors.append(processor_name) %}
  {{ processor_name }}:
{% if processor_name == 'batch' %}
    # Batch processor with default values
{% elif processor_name == 'memory_limiter' %}
    check_interval: 5s
    limit_mib: {{ processor_config.limit_mib | default(500) }}
    spike_limit_mib: {{ processor_config.spike_limit_mib | default(100) }}
{% elif processor_name == 'resourcedetection' %}
    detectors: {{ processor_config.detectors | default(['system', 'env']) | to_json }}
{% endif %}
{% endif %}
{% endfor %}

# EXPORTERS
exporters:
{% for exporter_name, exporter_config in effective_otelcol_config.exporters.items() %}
{% if exporter_config.enabled | default(false) %}
{% set _ = enabled_exporters.append(exporter_name) %}
  {{ exporter_name }}:
{% if exporter_name == 'logging' %}
    verbosity: {{ exporter_config.verbosity | default('detailed') }}
{% elif exporter_name == 'otlp' %}
    endpoint: {{ exporter_config.endpoint }}
    tls:
      insecure: {{ exporter_config.insecure | default(true) }}
{% elif exporter_name == 'prometheus' %}
    endpoint: {{ exporter_config.endpoint | default('0.0.0.0:8889') }}
    namespace: {{ exporter_config.namespace | default('otelcol') }}
{% elif exporter_name == 'splunk_hec' %}
    token: {{ exporter_config.token }}
    endpoint: {{ exporter_config.endpoint }}
    source: {{ exporter_config.source | default('otelcol') }}
    sourcetype: {{ exporter_config.sourcetype | default('otelcol') }}
    index: {{ exporter_config.index | default('main') }}
    tls:
      insecure: {{ exporter_config.insecure | default(false) }}
{% endif %}
{% endif %}
{% endfor %}

# SERVICE PIPELINES
service:
{% if effective_otelcol_config.service is defined and effective_otelcol_config.service.pipelines is defined %}
  pipelines:
{% for pipeline_name, pipeline in effective_otelcol_config.service.pipelines.items() %}
    {{ pipeline_name }}:
      receivers:
{% for receiver in pipeline.receivers | default([]) %}
{% if receiver in enabled_receivers %}
        - {{ receiver }}
{% endif %}
{% endfor %}
      processors:
{% for processor in pipeline.processors | default([]) %}
{% if processor in enabled_processors %}
        - {{ processor }}
{% endif %}
{% endfor %}
      exporters:
{% for exporter in pipeline.exporters | default([]) %}
{% if exporter in enabled_exporters %}
        - {{ exporter }}
{% endif %}
{% endfor %}
{% endfor %}
{% endif %}