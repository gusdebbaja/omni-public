# OpenTelemetry Collector Configuration
# Generated by Ansible



receivers:
  otlp:
    protocols:
      grpc:
        endpoint: 0.0.0.0:4317
      http:
        endpoint: 0.0.0.0:4318
  filelog:
    include: [ /opt/ping_results.log ]
    start_at: beginning
    operators:
      - type: regex_parser
        regex: '^(?P<timestamp>\d+) host=(?P<host>\S+) os=(?P<os>\S+) type=(?P<type>\S+)(?: ping_status=(?P<ping_status>\d))?(?: ssh_status=(?P<ssh_status>\d))?(?: sql_status=(?P<sql_status>\d))?'
        timestamp:
          parse_from: attributes.timestamp
          layout: '%s'
  hostmetrics:
    collection_interval: 1m
    scrapers:
      load:
      cpu:
        metrics:
          system.cpu.physical.count:
            enabled: true
          system.cpu.logical.count:
            enabled: true
          system.cpu.utilization:
            enabled: true
      filesystem:
        include_virtual_filesystems: true
        exclude_mount_points:
          mount_points:
            - "/proc.*"
            - "/sys.*"
            - "/run/credentials.*"
            - "/snap.*"
            - "/var/lib/docker.*"
            - "/var/lib/nfs.*"
            - "/dev.*"
          match_type: regexp
      network:
        metrics:
          system.network.conntrack.count:
            enabled: true
          system.network.conntrack.max:
            enabled: true
      memory:
        metrics:
          system.linux.memory.available:
            enabled: true
          system.memory.limit:
            enabled: true
          system.memory.utilization:
            enabled: true
      paging:
        metrics:
          system.paging.utilization:
            enabled: true
      process:
        include:
          names: ["crond", "cortex", "rsyslogd", "vmtoolsd", "xearch", "chronyd"]
          match_type: strict
        metrics:
          process.context_switches:
            enabled: true
          process.cpu.utilization:
            enabled: true
          process.disk.operations:
            enabled: true
          process.memory.utilization:
            enabled: true
          process.open_file_descriptors:
            enabled: true
          process.threads:
            enabled: true
          process.uptime:
            enabled: true
        mute_process_all_errors: true
        mute_process_name_error: true
        mute_process_exe_error: true
        mute_process_io_error: true
        mute_process_user_error: true
        mute_process_cgroup_error: true
      system:
      processes:
      disk:
processors:
  # This processor specifically targets process metrics
  batch:
  memory_limiter:
    check_interval: 1s
    limit_mib: 500
    spike_limit_mib: 200
  resourcedetection:
    detectors: [system, env]
    override: false
    system:
      hostname_sources: [os, dns, cname]
exporters:
  debug:
    verbosity: detailed
  splunk_hec/metrics:
    token: ${env:pass_splunk_token}
    endpoint: "https://xxxxx/services/collector"
    source: "redhat_infra_metrics"
    sourcetype: "metrics"
    index: "xx-metrics"
    tls:
      insecure_skip_verify: true
  splunk_hec/logs:
    token: ${env:pass_splunk_token}
    endpoint: "https://xxxx/services/collector"
    source: "redhat_infra_metrics"
    sourcetype: "pingChecks"
    index: "xx-traces"
    tls:
     insecure_skip_verify: true
  splunk_hec/traces:
    token: ${env:pass_splunk_token}
    endpoint: "https://xxxx:8088/services/collector"
    source: "redhat_traces"
    index: "xx-traces"
    sourcetype: "traces"
    tls:
     insecure_skip_verify: true
service:
  telemetry:
    logs:
      level: info
    metrics:
      readers:
        - pull:
            exporter:
              prometheus:
                host: '0.0.0.0'
                port: 8888
  pipelines:
    traces:
      receivers:
      - otlp
      processors:
      - batch
      - resourcedetection
      exporters:
      - splunk_hec/traces
      - debug
    logs:
      receivers:
      - filelog
      - otlp
      processors:
      - batch
      - resourcedetection
      exporters:
      - splunk_hec/logs
      - debug
    metrics:
      receivers:
      - otlp
      - hostmetrics
      processors:
      - batch
      - resourcedetection
      exporters:
      - splunk_hec/metrics
      #- debug

